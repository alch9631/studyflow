{
  "cli": {
    "version": ">= 27.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "STUDYFLOW_DEV_NETWORK": "1"
      },
      "ios": {
        "image": "sdk-58"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://avi-pi.tail76033e.ts.net:8443"
      },
      "ios": {
        "image": "sdk-58"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://avi-pi.tail76033e.ts.net:8443"
      },
      "ios": {
        "image": "sdk-58"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "4K5P6S4BXZ",
        "language": "en-US",
        "sku": "app.studyflow.mobile"
      }
    }
  }
}
